LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=gsk_your-groq-key
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b
GOOGLE_API_KEY=your-gemini-api-key   # optional: fallback LLM + embeddings

# Neon: either DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require  or the parts below
DB_HOST=ep-xxxx.ap-southeast-1.aws.neon.tech
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password
DB_PORT=5432
DB_SSLMODE=require

GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest
EMBEDDING_MODEL=models/gemini-embedding-001
ALLOWED_ORIGINS=*
