LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=gsk_your-groq-key
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b
GOOGLE_API_KEY=your-gemini-api-key   # optional: fallback LLM + embeddings

# Neon: either DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require  or the parts below
DB_HOST=ep-xxxx.ap-southeast-1.aws.neon.tech
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password
DB_PORT=5432
DB_SSLMODE=require

GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest
EMBEDDING_MODEL=models/gemini-embedding-001
ALLOWED_ORIGINS=*

# Video audit (uses GOOGLE_API_KEY). Models are tried in this order.
VIDEO_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
VIDEO_MAX_SECONDS=20
# auto = Gemini first, Groq backup when Gemini is busy | groq = always the backup engine | gemini = Gemini only
VIDEO_ENGINE=auto
GROQ_VISION_MODELS=qwen/qwen3.6-27b,meta-llama/llama-4-scout-17b-16e-instruct

# Sign-in + approval workflow. REQUIRED for /api/auth and /api/workflow. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_TOKEN_HOURS=12
